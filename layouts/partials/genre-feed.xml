{{- $pages := .RegularPages -}}
{{- if eq .Kind "taxonomy" -}}{{ $pages = where site.RegularPages "Type" "events" }}{{- end -}}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
<channel>
<title>{{ .Title }} — {{ site.Title }}</title>
<link>{{ .Permalink }}</link>
<description>DJ sets: {{ .Title }}</description>
<atom:link href="{{ .Permalink }}index.xml" rel="self" type="application/rss+xml"/>
{{ range $pages.ByDate.Reverse }}
<item>
<title>{{ partial "set-title.html" . }}</title>
<link>{{ .Permalink }}</link>
<guid>{{ .Permalink }}</guid>
<pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
<description>{{ .Summary | html }}</description>
{{ with .Params.embed.url }}<enclosure url="{{ . }}" type="audio/mpeg" length="0"/>{{ end }}
</item>
{{ end }}
</channel>
</rss>
